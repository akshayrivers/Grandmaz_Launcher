<?xml version="1.0" encoding="utf-8"?>
<!-- Background for contact cards on home screen.
     Rounded square with white fill and soft shadow handled by CardView. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/color_bg_card" />
    <stroke
        android:width="@dimen/control_border_width"
        android:color="@color/color_control_border" />
    <corners android:radius="@dimen/control_corner_radius" />
</shape>
