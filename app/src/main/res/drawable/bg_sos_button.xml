<?xml version="1.0" encoding="utf-8"?>
<!-- SOS button background.
     Selector switches between normal and pressed states.
     No ripple effect — the progress ring IS the feedback. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/color_sos_red_dark" />
            <stroke
                android:width="@dimen/control_border_width"
                android:color="@color/color_control_border" />
            <corners android:radius="@dimen/control_corner_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/color_sos_red" />
            <stroke
                android:width="@dimen/control_border_width"
                android:color="@color/color_control_border" />
            <corners android:radius="@dimen/control_corner_radius" />
        </shape>
    </item>
</selector>
