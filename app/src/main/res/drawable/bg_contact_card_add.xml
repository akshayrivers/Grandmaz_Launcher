<?xml version="1.0" encoding="utf-8"?>
<!-- Background for the empty "Add Contact" slot.
     Slightly darker than white — visually distinct from filled
     contact cards but the same shape and size.
     Dashed border signals "this is a slot to fill". -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/color_bg_secondary" />
    <stroke
        android:width="@dimen/control_border_width"
        android:color="@color/color_control_border" />
    <corners android:radius="@dimen/control_corner_radius" />
</shape>
