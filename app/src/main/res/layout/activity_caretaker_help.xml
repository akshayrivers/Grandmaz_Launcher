<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/caretakerHelpRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/screen_margin_horizontal"
        android:paddingBottom="120dp">

    <ImageButton
        android:id="@+id/btnSendHelp"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/space_xxl"
        android:background="@drawable/bg_control"
        android:contentDescription="@string/screen_ask_for_help"
        android:padding="48dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_caretaker_info" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/btnEditHome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:padding="@dimen/space_md"
        android:text="@string/caretaker_edit_home"
        android:textAppearance="@style/TextAppearance.Grandma.LabelMedium"
        android:textColor="@color/color_text_secondary" />

    </LinearLayout>

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/fab_caretaker_margin_horizontal"
        android:layout_marginBottom="@dimen/fab_caretaker_margin_bottom"
        android:background="@drawable/bg_control"
        android:contentDescription="@string/action_home"
        android:elevation="12dp"
        android:padding="18dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_house" />

</FrameLayout>
