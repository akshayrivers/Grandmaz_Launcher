<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/caretakerHelpRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/screen_margin_horizontal">

        <ImageButton
            android:id="@+id/btnSendHelp"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_xxl"
            android:background="@drawable/bg_control"
            android:contentDescription="@string/screen_ask_for_help"
            android:padding="48dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_caretaker_info" />

        <TextView
            android:id="@+id/tvHelpSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:gravity="center"
            android:text="@string/caretaker_help_subtitle"
            android:textAppearance="@style/TextAppearance.Grandma.LabelMedium"
            android:textColor="@color/color_text_secondary" />

        <TextView
            android:id="@+id/tvHelpPeople"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:gravity="center"
            android:text="@string/caretaker_list_empty"
            android:textAppearance="@style/TextAppearance.Grandma.LabelLarge" />

        <TextView
            android:id="@+id/tvOffline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:gravity="center"
            android:text="@string/caretaker_offline"
            android:textAppearance="@style/TextAppearance.Grandma.LabelLarge"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvHelpStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Grandma.LabelMedium"
            android:textColor="@color/color_text_secondary" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

    <TextView
        android:id="@+id/btnEditHome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="@dimen/floating_content_side_inset"
        android:layout_marginEnd="@dimen/floating_content_side_inset"
        android:layout_marginBottom="@dimen/floating_content_clearance"
        android:gravity="center"
        android:minHeight="@dimen/touch_target_min"
        android:text="@string/caretaker_edit_home"
        android:textAppearance="@style/TextAppearance.Grandma.LabelMedium"
        android:textColor="@color/color_text_secondary" />

</FrameLayout>
