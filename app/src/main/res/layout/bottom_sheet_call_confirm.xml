<?xml version="1.0" encoding="utf-8"?>
<!--
    Call confirmation.
    The face is shown again, then two equal buttons: phone and a cross.
    The sheet says the name. The phone button says "call" only after she presses it.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/color_bg_card"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/space_xl">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="160dp"
        android:layout_height="160dp"
        app:cardBackgroundColor="@color/color_control_fill"
        app:cardCornerRadius="@dimen/control_corner_radius"
        app:cardElevation="0dp"
        app:strokeColor="@color/color_control_border"
        app:strokeWidth="@dimen/control_border_width">

        <ImageView
            android:id="@+id/ivConfirmPhoto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/nav_people"
            android:scaleType="centerCrop" />

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvConfirmTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Grandma.Heading"
        android:textColor="@color/color_text_secondary" />

    <ImageButton
        android:id="@+id/btnConfirmYes"
        android:layout_width="match_parent"
        android:layout_height="@dimen/primary_action_height"
        android:layout_marginTop="@dimen/space_xl"
        android:background="@drawable/bg_control"
        android:contentDescription="@string/confirm_call_yes"
        android:padding="28dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_nav_phone" />

    <ImageButton
        android:id="@+id/btnConfirmNo"
        android:layout_width="match_parent"
        android:layout_height="@dimen/primary_action_height"
        android:layout_marginTop="@dimen/space_md"
        android:background="@drawable/bg_control"
        android:contentDescription="@string/confirm_call_no"
        android:padding="28dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_nav_close" />

</LinearLayout>
