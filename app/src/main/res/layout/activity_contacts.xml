<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/contactsRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_primary">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_margin_horizontal">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="@dimen/screen_margin_top"
                android:paddingBottom="@dimen/space_md">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="@dimen/touch_target_min"
                    android:layout_height="@dimen/touch_target_min"
                    android:background="@drawable/bg_control"
                    android:contentDescription="@string/action_home"
                    android:padding="18dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_house" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_sm"
                    android:text="@string/screen_your_people"
                    android:textAppearance="@style/TextAppearance.Grandma.Display" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/color_divider"
                android:layout_marginBottom="@dimen/space_md" />

            <!-- Contact grid — 2 columns, populated by activity -->
            <GridLayout
                android:id="@+id/gridAllContacts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:useDefaultMargins="false" />

        </LinearLayout>
    </ScrollView>

    <!-- Caretaker FAB — present on this screen too -->
    <ImageButton
        android:id="@+id/fabCaretaker"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:layout_gravity="bottom|start"
        android:layout_margin="@dimen/fab_caretaker_margin_horizontal"
        android:background="@drawable/bg_control"
        android:contentDescription="@string/screen_ask_for_help"
        android:padding="18dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_caretaker_info" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
