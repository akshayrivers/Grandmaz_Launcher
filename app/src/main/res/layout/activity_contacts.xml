<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/contactsRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_primary">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin_horizontal"
            android:paddingTop="@dimen/screen_margin_horizontal"
            android:paddingEnd="@dimen/screen_margin_horizontal"
            android:paddingBottom="@dimen/floating_content_clearance">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/screen_margin_top"
                android:paddingBottom="@dimen/space_md"
                android:text="@string/screen_your_people"
                android:textAppearance="@style/TextAppearance.Grandma.LabelMedium"
                android:textColor="@color/color_text_secondary" />

            <!-- Contact grid — 2 columns, populated by activity -->
            <GridLayout
                android:id="@+id/gridAllContacts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:useDefaultMargins="false" />

        </LinearLayout>
    </ScrollView>

    <ImageButton
        android:id="@+id/fabCaretaker"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="@dimen/fab_caretaker_margin_horizontal"
        android:layout_marginBottom="@dimen/fab_caretaker_margin_bottom"
        android:background="@drawable/bg_control"
        android:contentDescription="@string/screen_ask_for_help"
        android:elevation="12dp"
        android:padding="18dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_caretaker_info" />

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/fab_caretaker_margin_horizontal"
        android:layout_marginBottom="@dimen/fab_caretaker_margin_bottom"
        android:background="@drawable/bg_control"
        android:contentDescription="@string/action_home"
        android:elevation="12dp"
        android:padding="18dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_house" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
