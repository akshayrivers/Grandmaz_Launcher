<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/messageRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_primary">

<LinearLayout
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingBottom="@dimen/floating_content_clearance">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/space_lg"
        app:cardBackgroundColor="@color/color_control_fill"
        app:cardCornerRadius="@dimen/control_corner_radius"
        app:cardElevation="0dp"
        app:strokeColor="@color/color_control_border"
        app:strokeWidth="@dimen/control_border_width">

        <ImageView
            android:id="@+id/ivCaretaker"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/message_from_caretaker"
            android:padding="36dp"
            android:src="@drawable/ic_caretaker_info" />
    </com.google.android.material.card.MaterialCardView>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_lg"
        android:layout_weight="1">

        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Grandma.Display"
            android:textColor="@color/color_text_secondary" />
    </ScrollView>

    <ImageButton
        android:id="@+id/btnSpeakAgain"
        android:layout_width="match_parent"
        android:layout_height="@dimen/primary_action_height"
        android:layout_marginTop="@dimen/space_md"
        android:background="@drawable/bg_control"
        android:contentDescription="@string/message_speak_again"
        android:padding="28dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_nav_mic" />

</LinearLayout>

    <ImageButton
        android:id="@+id/fabCaretaker"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="@dimen/fab_caretaker_margin_horizontal"
        android:layout_marginBottom="@dimen/fab_caretaker_margin_bottom"
        android:background="@drawable/bg_control"
        android:contentDescription="@string/screen_ask_for_help"
        android:elevation="12dp"
        android:padding="18dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_caretaker_info" />

    <ImageButton
        android:id="@+id/btnOk"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/fab_caretaker_margin_horizontal"
        android:layout_marginBottom="@dimen/fab_caretaker_margin_bottom"
        android:background="@drawable/bg_control"
        android:contentDescription="@string/message_ok_description"
        android:elevation="12dp"
        android:padding="18dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_house" />

</FrameLayout>
