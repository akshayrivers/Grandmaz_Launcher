<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/addContactRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_primary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_margin_horizontal">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="@dimen/screen_margin_top"
            android:paddingBottom="@dimen/space_md">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="@dimen/back_button_size"
                android:layout_height="@dimen/back_button_size"
                android:src="@android:drawable/ic_media_previous"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_sm"
                android:text="@string/screen_add_person"
                android:textAppearance="@style/TextAppearance.Grandma.Display" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/color_divider"
            android:layout_marginBottom="@dimen/space_xl" />

        <!-- Photo preview -->
        <ImageView
            android:id="@+id/ivPhotoPreview"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center_horizontal"
            android:scaleType="centerCrop"
            android:clipToOutline="true"
            android:background="@drawable/bg_circle_photo"
            android:src="@android:drawable/ic_menu_gallery"
            android:contentDescription="Contact photo preview" />

        <!-- Camera / gallery buttons -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTakePhoto"
            style="@style/Widget.Grandma.ToolButton.Camera"
            android:layout_width="match_parent"
            android:layout_height="@dimen/tool_button_height"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/add_contact_take_photo"
            app:icon="@android:drawable/ic_menu_camera"
            app:iconGravity="start" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChooseGallery"
            style="@style/Widget.Grandma.ToolButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/tool_button_height"
            android:layout_marginTop="@dimen/space_sm"
            android:backgroundTint="@color/color_bg_secondary"
            android:textColor="@color/color_text_primary"
            android:text="@string/add_contact_choose_gallery"
            app:icon="@android:drawable/ic_menu_gallery"
            app:iconTint="@color/color_text_secondary"
            app:iconGravity="start" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/color_divider"
            android:layout_marginTop="@dimen/space_xl"
            android:layout_marginBottom="@dimen/space_lg" />

        <!-- Name input -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/add_contact_name_prompt"
            android:textAppearance="@style/TextAppearance.Grandma.LabelLarge"
            android:layout_marginBottom="@dimen/space_sm" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etContactName"
                android:layout_width="match_parent"
                android:layout_height="@dimen/text_input_height"
                android:hint="@string/add_contact_name_hint"
                android:textSize="20sp"
                android:inputType="textPersonName|textCapWords"
                android:imeOptions="actionNext" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Phone input -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Phone Number"
            android:textAppearance="@style/TextAppearance.Grandma.LabelLarge"
            android:layout_marginTop="@dimen/space_lg"
            android:layout_marginBottom="@dimen/space_sm" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etContactPhone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/text_input_height"
                android:hint="+91 XXXXX XXXXX"
                android:textSize="20sp"
                android:inputType="phone"
                android:imeOptions="actionDone" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Save button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveContact"
            style="@style/Widget.Grandma.ConfirmButton.Yes"
            android:layout_width="match_parent"
            android:layout_height="@dimen/confirm_button_height"
            android:layout_marginTop="@dimen/space_xl"
            android:layout_marginBottom="@dimen/space_xl"
            android:text="@string/add_contact_save" />

    </LinearLayout>
</ScrollView>
