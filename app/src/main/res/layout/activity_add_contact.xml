<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/addContactRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_primary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_margin_horizontal">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:layout_marginTop="@dimen/screen_margin_top"
            android:background="@drawable/bg_control"
            android:contentDescription="@string/action_home"
            android:padding="18dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_house" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_lg"
            app:cardBackgroundColor="@color/color_control_fill"
            app:cardCornerRadius="@dimen/control_corner_radius"
            app:cardElevation="0dp"
            app:strokeColor="@color/color_control_border"
            app:strokeWidth="@dimen/control_border_width">

            <ImageView
                android:id="@+id/ivPhotoPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/nav_add_person"
                android:padding="48dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_camera" />
        </com.google.android.material.card.MaterialCardView>

        <ImageButton
            android:id="@+id/btnTakePhoto"
            android:layout_width="match_parent"
            android:layout_height="@dimen/primary_action_height"
            android:layout_marginTop="@dimen/space_lg"
            android:background="@drawable/bg_control"
            android:contentDescription="@string/add_contact_take_photo"
            android:padding="28dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_nav_camera" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChooseGallery"
            style="@style/Widget.Grandma.ConfirmButton.No"
            android:layout_width="match_parent"
            android:layout_height="@dimen/confirm_button_height"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/add_contact_choose_gallery" />

        <LinearLayout
            android:id="@+id/groupVoice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btnRecordName"
                android:layout_width="match_parent"
                android:layout_height="@dimen/primary_action_height"
                android:layout_marginTop="@dimen/space_lg"
                android:background="@drawable/bg_control"
                android:contentDescription="@string/add_contact_record_name"
                android:padding="28dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_mic" />

            <ImageButton
                android:id="@+id/btnSaveContact"
                android:layout_width="match_parent"
                android:layout_height="@dimen/primary_action_height"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_control"
                android:contentDescription="@string/add_contact_save"
                android:padding="28dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_check"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:layout_marginBottom="@dimen/space_sm"
                android:text="@string/add_contact_name_prompt"
                android:textAppearance="@style/TextAppearance.Grandma.LabelMedium"
                android:textColor="@color/color_text_secondary" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etContactName"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/text_input_height"
                    android:hint="@string/add_contact_name_hint"
                    android:imeOptions="actionNext"
                    android:inputType="textPersonName|textCapWords"
                    android:textColor="@color/color_text_primary"
                    android:textSize="20sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:layout_marginBottom="@dimen/space_sm"
                android:text="@string/add_contact_phone_prompt"
                android:textAppearance="@style/TextAppearance.Grandma.LabelMedium"
                android:textColor="@color/color_text_secondary" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etContactPhone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/text_input_height"
                    android:hint="+91 XXXXX XXXXX"
                    android:imeOptions="actionDone"
                    android:inputType="phone"
                    android:textColor="@color/color_text_primary"
                    android:textSize="20sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnImportContact"
                style="@style/Widget.Grandma.ConfirmButton.No"
                android:layout_width="match_parent"
                android:layout_height="@dimen/confirm_button_height"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/add_contact_import" />

            <CheckBox
                android:id="@+id/cbWhatsapp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:layout_marginBottom="@dimen/space_xl"
                android:minHeight="80dp"
                android:text="@string/add_contact_whatsapp"
                android:textColor="@color/color_text_secondary"
                android:textSize="20sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
