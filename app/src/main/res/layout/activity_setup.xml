<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/setupRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_primary"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_margin_horizontal"
    android:paddingEnd="@dimen/screen_margin_horizontal">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSetupTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/screen_margin_top"
                android:text="@string/setup_title"
                android:textAppearance="@style/TextAppearance.Grandma.Display"
                android:textColor="@color/color_accent_amber" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/setup_subtitle"
                android:textAppearance="@style/TextAppearance.Grandma.LabelLarge"
                android:textColor="@color/color_text_secondary" />

            <TextView
                android:id="@+id/tvStepIndicator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:layout_marginBottom="@dimen/space_md"
                android:textColor="@color/color_accent_amber"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Step 1 of 5" />

            <!-- ═══════════ STEP: LANGUAGE ═══════════ -->
            <LinearLayout
                android:id="@+id/layoutStepLanguage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setup_language_title"
                    android:textAppearance="@style/TextAppearance.Grandma.Heading" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/setup_language_desc"
                    android:textAppearance="@style/TextAppearance.Grandma.LabelLarge"
                    android:textColor="@color/color_text_secondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLanguageHindi"
                    style="@style/Widget.Grandma.ConfirmButton.No"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/primary_action_height"
                    android:layout_marginTop="@dimen/space_lg"
                    android:text="@string/setup_language_hindi"
                    android:textSize="24sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLanguageEnglish"
                    style="@style/Widget.Grandma.ConfirmButton.No"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/primary_action_height"
                    android:layout_marginTop="@dimen/space_md"
                    android:text="@string/setup_language_english"
                    android:textSize="24sp" />
            </LinearLayout>

            <!-- ═══════════ STEP: CARETAKER EMAIL ═══════════ -->
            <LinearLayout
                android:id="@+id/layoutStepEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setup_email_title"
                    android:textAppearance="@style/TextAppearance.Grandma.Heading" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/setup_email_desc"
                    android:textAppearance="@style/TextAppearance.Grandma.LabelLarge"
                    android:textColor="@color/color_text_secondary" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCaretakerEmail"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:hint="@string/setup_email_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCaretakerEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:inputType="textEmailAddress"
                        android:minHeight="@dimen/touch_target_min"
                        android:textSize="20sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/tvEmailAlreadyLinked"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:text="@string/setup_email_already_linked"
                    android:textAppearance="@style/TextAppearance.Grandma.LabelLarge"
                    android:textColor="@color/color_accent_green"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- ═══════════ STEP: PAIRING CODE ═══════════ -->
            <LinearLayout
                android:id="@+id/layoutStepPairing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setup_pairing_title"
                    android:textAppearance="@style/TextAppearance.Grandma.Heading" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/setup_pairing_desc"
                    android:textAppearance="@style/TextAppearance.Grandma.LabelLarge"
                    android:textColor="@color/color_text_secondary" />

                <TextView
                    android:id="@+id/tvPairingCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xl"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.1"
                    android:textColor="@color/color_text_primary"
                    android:textIsSelectable="true"
                    android:textSize="64sp"
                    android:textStyle="bold"
                    tools:text="123 456" />

                <ProgressBar
                    android:id="@+id/progressPairing"
                    style="?android:attr/progressBarStyleLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:indeterminateTint="@color/color_accent_amber" />

                <TextView
                    android:id="@+id/tvPairingStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.Grandma.Heading"
                    tools:text="@string/setup_pairing_waiting" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPairingRetry"
                    style="@style/Widget.Grandma.ConfirmButton.Amber"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_target_min"
                    android:layout_marginTop="@dimen/space_lg"
                    android:text="@string/setup_btn_try_again"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- ═══════════ STEP: PIN ═══════════ -->
            <LinearLayout
                android:id="@+id/layoutStepPin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setup_pin_title"
                    android:textAppearance="@style/TextAppearance.Grandma.Heading" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/setup_pin_desc"
                    android:textAppearance="@style/TextAppearance.Grandma.LabelLarge"
                    android:textColor="@color/color_text_secondary" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPin"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:hint="@string/setup_pin_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAutofill="no"
                        android:inputType="numberPassword"
                        android:maxLength="6"
                        android:minHeight="@dimen/touch_target_min"
                        android:textSize="24sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPinConfirm"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:hint="@string/setup_pin_confirm_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPinConfirm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:importantForAutofill="no"
                        android:inputType="numberPassword"
                        android:maxLength="6"
                        android:minHeight="@dimen/touch_target_min"
                        android:textSize="24sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- ═══════════ STEP: LAUNCHER + PERMISSIONS ═══════════ -->
            <LinearLayout
                android:id="@+id/layoutStepPermissions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setup_permissions_title"
                    android:textAppearance="@style/TextAppearance.Grandma.Heading" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/setup_permissions_desc"
                    android:textAppearance="@style/TextAppearance.Grandma.LabelLarge"
                    android:textColor="@color/color_text_secondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSetDefaultLauncher"
                    style="@style/Widget.Grandma.ConfirmButton.Amber"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_target_min"
                    android:layout_marginTop="@dimen/space_lg"
                    android:text="@string/setup_set_default_launcher" />

                <TextView
                    android:id="@+id/tvLauncherStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:textAppearance="@style/TextAppearance.Grandma.LabelLarge" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGrantCallPermission"
                    style="@style/Widget.Grandma.ConfirmButton.Amber"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_target_min"
                    android:layout_marginTop="@dimen/space_lg"
                    android:text="@string/setup_grant_call_permission" />

                <TextView
                    android:id="@+id/tvCallPermissionStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:textAppearance="@style/TextAppearance.Grandma.LabelLarge" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGrantOptionalPermissions"
                    style="@style/Widget.Grandma.ConfirmButton.No"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_target_min"
                    android:layout_marginTop="@dimen/space_lg"
                    android:text="@string/setup_grant_optional_permissions" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ═══════════ BOTTOM NAVIGATION ═══════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:layout_marginBottom="@dimen/space_md"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackStep"
            style="@style/Widget.Grandma.ConfirmButton.No"
            android:layout_width="0dp"
            android:layout_height="@dimen/touch_target_min"
            android:layout_marginEnd="@dimen/space_sm"
            android:layout_weight="1"
            android:text="@string/action_back" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNextStep"
            style="@style/Widget.Grandma.ConfirmButton.Yes"
            android:layout_width="0dp"
            android:layout_height="@dimen/touch_target_min"
            android:layout_weight="2"
            android:text="@string/setup_btn_next" />
    </LinearLayout>

</LinearLayout>
