<?xml version="1.0" encoding="utf-8"?>
<!--
    Home Screen Layout
    The page scrolls on a short phone. House and caretaker stay in the corners.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_primary">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/homeScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/floating_content_clearance">

            <com.grandma.launcher.ui.home.HomeHeaderView
                android:id="@+id/homeHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvYourPeople"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvSeeAll"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <GridLayout
                android:id="@+id/gridContacts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:columnCount="2"
                android:rowCount="2" />

            <ImageButton
                android:id="@+id/btnMorePeople"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target_min"
                android:layout_marginTop="@dimen/space_sm"
                android:background="@drawable/bg_control"
                android:contentDescription="@string/nav_people"
                android:padding="18dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_people" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnCamera"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_target_min"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:layout_weight="1"
                    android:background="@drawable/bg_control"
                    android:contentDescription="@string/action_camera"
                    android:padding="18dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_nav_camera" />

                <ImageButton
                    android:id="@+id/btnWhatsapp"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_target_min"
                    android:layout_marginStart="@dimen/space_sm"
                    android:layout_weight="1"
                    android:background="@drawable/bg_control"
                    android:contentDescription="@string/action_whatsapp"
                    android:padding="18dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_nav_chat" />
            </LinearLayout>

            <com.grandma.launcher.ui.views.SosButtonView
                android:id="@+id/sosButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/sos_button_height"
                android:layout_marginTop="@dimen/space_sm" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStopAlerts"
                style="@style/Widget.Grandma.ConfirmButton.No"
                android:layout_width="match_parent"
                android:layout_height="@dimen/confirm_button_height"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/sos_stop_alerts"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnWeather"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_target_min"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:layout_weight="1"
                    android:background="@drawable/bg_control"
                    android:contentDescription="@string/nav_weather"
                    android:padding="16dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_nav_sun" />

                <ImageButton
                    android:id="@+id/btnAddPerson"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_target_min"
                    android:layout_marginStart="@dimen/space_xs"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:layout_weight="1"
                    android:background="@drawable/bg_control"
                    android:contentDescription="@string/nav_add_person"
                    android:padding="16dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_nav_add" />

                <ImageButton
                    android:id="@+id/btnAsk"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_target_min"
                    android:layout_marginStart="@dimen/space_xs"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:layout_weight="1"
                    android:background="@drawable/bg_control"
                    android:contentDescription="@string/nav_ask"
                    android:padding="16dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_nav_mic" />

                <ImageButton
                    android:id="@+id/btnApps"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_target_min"
                    android:layout_marginStart="@dimen/space_xs"
                    android:layout_weight="1"
                    android:background="@drawable/bg_control"
                    android:contentDescription="@string/nav_apps"
                    android:padding="16dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_nav_apps" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ImageButton
        android:id="@+id/btnHouse"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/fab_caretaker_margin_horizontal"
        android:layout_marginBottom="@dimen/fab_caretaker_margin_bottom"
        android:background="@drawable/bg_control"
        android:contentDescription="@string/action_home"
        android:elevation="12dp"
        android:padding="18dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_house" />

    <ImageButton
        android:id="@+id/fabCaretaker"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="@dimen/fab_caretaker_margin_horizontal"
        android:layout_marginBottom="@dimen/fab_caretaker_margin_bottom"
        android:background="@drawable/bg_control"
        android:contentDescription="@string/screen_ask_for_help"
        android:elevation="12dp"
        android:padding="18dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_caretaker_info" />

</FrameLayout>
