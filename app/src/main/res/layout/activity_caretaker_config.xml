<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/caretakerConfigRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_primary"
    android:orientation="vertical"
    android:padding="@dimen/screen_margin_horizontal">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="@dimen/screen_margin_top">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="@dimen/back_button_size"
            android:layout_height="@dimen/back_button_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_back"
            android:src="@android:drawable/ic_media_previous" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:layout_weight="1"
            android:text="@string/caretaker_edit_home"
            android:textAppearance="@style/TextAppearance.Grandma.Display" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:text="@string/caretaker_weather_city_label"
        android:textAppearance="@style/TextAppearance.Grandma.LabelLarge" />

    <EditText
        android:id="@+id/etWeatherCity"
        android:layout_width="match_parent"
        android:layout_height="@dimen/confirm_button_height"
        android:layout_marginTop="@dimen/space_sm"
        android:hint="@string/caretaker_weather_city_hint"
        android:importantForAutofill="no"
        android:inputType="textCapWords"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/tvConfigStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:textAppearance="@style/TextAppearance.Grandma.LabelLarge" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveConfig"
        style="@style/Widget.Grandma.ConfirmButton.Amber"
        android:layout_width="match_parent"
        android:layout_height="@dimen/confirm_button_height"
        android:layout_marginTop="@dimen/space_xl"
        android:text="@string/caretaker_save_home" />
</LinearLayout>
