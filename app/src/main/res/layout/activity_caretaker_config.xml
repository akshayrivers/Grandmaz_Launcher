<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/caretakerConfigRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_primary">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_margin_horizontal">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:paddingTop="@dimen/screen_margin_top"
                android:text="@string/caretaker_edit_home"
                android:textAppearance="@style/TextAppearance.Grandma.Display" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/caretaker_weather_city_label"
                android:textAppearance="@style/TextAppearance.Grandma.LabelLarge" />

            <EditText
                android:id="@+id/etWeatherCity"
                android:layout_width="match_parent"
                android:layout_height="@dimen/confirm_button_height"
                android:layout_marginTop="@dimen/space_sm"
                android:background="@drawable/bg_control"
                android:hint="@string/caretaker_weather_city_hint"
                android:importantForAutofill="no"
                android:inputType="textCapWords"
                android:paddingStart="@dimen/space_md"
                android:paddingEnd="@dimen/space_md"
                android:textColor="@color/color_text_primary"
                android:textColorHint="@color/color_text_secondary"
                android:textSize="22sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOverlayPermission"
                style="@style/Widget.Grandma.ConfirmButton.Amber"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target_min"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/caretaker_overlay_permission" />

            <TextView
                android:id="@+id/tvConfigStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:textAppearance="@style/TextAppearance.Grandma.LabelLarge" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveConfig"
                style="@style/Widget.Grandma.ConfirmButton.Amber"
                android:layout_width="match_parent"
                android:layout_height="@dimen/confirm_button_height"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/caretaker_save_home" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/caretaker_add_title"
                android:textAppearance="@style/TextAppearance.Grandma.LabelLarge" />

            <TextView
                android:id="@+id/tvOffline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/caretaker_offline"
                android:textAppearance="@style/TextAppearance.Grandma.LabelLarge"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvCaretakers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/caretaker_list_empty"
                android:textAppearance="@style/TextAppearance.Grandma.LabelMedium"
                android:textColor="@color/color_text_secondary" />

            <EditText
                android:id="@+id/etCaretakerEmail"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target_min"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_control"
                android:hint="@string/caretaker_add_email_hint"
                android:importantForAutofill="no"
                android:inputType="textEmailAddress"
                android:paddingStart="@dimen/space_md"
                android:paddingEnd="@dimen/space_md"
                android:textColor="@color/color_text_primary"
                android:textColorHint="@color/color_text_secondary"
                android:textSize="22sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddCaretaker"
                style="@style/Widget.Grandma.ConfirmButton.Yes"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target_min"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/caretaker_add_send" />

            <TextView
                android:id="@+id/tvInviteStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:textAppearance="@style/TextAppearance.Grandma.LabelMedium"
                android:textColor="@color/color_text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUninstall"
                style="@style/Widget.Grandma.ConfirmButton.No"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target_min"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/caretaker_uninstall" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="@dimen/floating_content_clearance" />
        </LinearLayout>
    </ScrollView>

    <ImageButton
        android:id="@+id/fabCaretaker"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="@dimen/fab_caretaker_margin_horizontal"
        android:layout_marginBottom="@dimen/fab_caretaker_margin_bottom"
        android:background="@drawable/bg_control"
        android:contentDescription="@string/screen_ask_for_help"
        android:elevation="12dp"
        android:padding="18dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_caretaker_info" />

</FrameLayout>
