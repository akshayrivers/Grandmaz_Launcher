<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/moreAppsRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/screen_margin_horizontal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="@dimen/screen_margin_top"
            android:paddingBottom="@dimen/space_md">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btnCaretakerSettings"
                android:layout_width="@dimen/back_button_size"
                android:layout_height="@dimen/back_button_size"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/pin_apps_title"
                android:src="@android:drawable/ic_menu_preferences"
                app:tint="@color/color_text_secondary" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/apps_empty_helper"
            android:textAppearance="@style/TextAppearance.Grandma.LabelMedium"
            android:textColor="@color/color_text_secondary"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvApps"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/floating_content_clearance" />

    </LinearLayout>

    <ImageButton
        android:id="@+id/fabCaretaker"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="@dimen/fab_caretaker_margin_horizontal"
        android:layout_marginBottom="@dimen/fab_caretaker_margin_bottom"
        android:background="@drawable/bg_control"
        android:contentDescription="@string/screen_ask_for_help"
        android:elevation="12dp"
        android:padding="18dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_caretaker_info" />

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/fab_caretaker_margin_horizontal"
        android:layout_marginBottom="@dimen/fab_caretaker_margin_bottom"
        android:background="@drawable/bg_control"
        android:contentDescription="@string/action_home"
        android:elevation="12dp"
        android:padding="18dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_house" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
