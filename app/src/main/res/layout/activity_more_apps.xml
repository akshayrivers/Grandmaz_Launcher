<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/screen_margin_horizontal">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="@dimen/screen_margin_top"
            android:paddingBottom="@dimen/space_md">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="@dimen/back_button_size"
                android:layout_height="@dimen/back_button_size"
                android:src="@android:drawable/ic_media_previous"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_sm"
                android:text="@string/screen_all_apps"
                android:textAppearance="@style/TextAppearance.Grandma.Display" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/color_divider"
            android:layout_marginBottom="@dimen/space_md" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvApps"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

    <!-- Caretaker FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabCaretaker"
        android:layout_width="@dimen/fab_caretaker_size"
        android:layout_height="@dimen/fab_caretaker_size"
        android:layout_gravity="bottom|start"
        android:layout_margin="@dimen/fab_caretaker_margin_horizontal"
        android:contentDescription="Ask for help"
        android:elevation="8dp"
        app:backgroundTint="@color/color_accent_amber"
        app:tint="@color/color_text_on_dark"
        app:srcCompat="@android:drawable/ic_dialog_info"
        app:fabSize="normal" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
