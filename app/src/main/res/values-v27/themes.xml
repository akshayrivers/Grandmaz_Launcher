<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- windowLightNavigationBar is API 27. minSdk is 26, so it cannot live in values/. -->
    <style name="Theme.GrandmasLauncher" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/color_text_primary</item>
        <item name="colorPrimaryVariant">@color/color_text_primary</item>
        <item name="colorOnPrimary">@color/color_text_on_dark</item>

        <item name="colorSecondary">@color/color_text_primary</item>
        <item name="colorOnSecondary">@color/color_text_on_dark</item>

        <item name="colorSurface">@color/color_bg_card</item>
        <item name="colorOnSurface">@color/color_text_primary</item>
        <item name="colorOnBackground">@color/color_text_primary</item>

        <item name="android:colorBackground">@color/color_bg_primary</item>
        <item name="android:windowBackground">@color/color_bg_primary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/window_light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/window_light_system_bars</item>

        <!-- Light parent would paint helper fields black on the black page. -->
        <item name="android:editTextColor">@color/color_text_primary</item>
        <item name="android:textColorHint">@color/color_text_secondary</item>

        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
