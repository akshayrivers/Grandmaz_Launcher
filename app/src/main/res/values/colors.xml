<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Dark launcher palette. Night mode is locked off in GrandmaApplication so MIUI
         cannot swap this for a second set. Faces stay in colour. Chrome is black and white.
         Red is SOS only. -->

    <!-- Page and control fill. Pure black so a white border is what she sees. -->
    <color name="color_bg_primary">#000000</color>
    <color name="color_bg_secondary">#000000</color>
    <color name="color_bg_card">#000000</color>
    <color name="color_control_fill">#000000</color>

    <!-- Ink and the 3dp border. White on black is the control. -->
    <color name="color_text_primary">#FFFFFF</color>
    <!-- Helper-only labels. She navigates by picture and voice. -->
    <color name="color_text_secondary">#9A9A9A</color>
    <color name="color_text_on_dark">#FFFFFF</color>
    <color name="color_control_border">#FFFFFF</color>
    <color name="color_divider">#FFFFFF</color>

    <!-- SOS label and hold ring. White on the red fill. -->
    <color name="color_sos_label">#FFFFFF</color>

    <!-- Kept so existing layouts compile. They are ink now, not blue, green, or amber. -->
    <color name="color_accent_blue">#FFFFFF</color>
    <color name="color_accent_blue_light">#000000</color>
    <color name="color_accent_green">#FFFFFF</color>
    <color name="color_accent_green_light">#000000</color>
    <color name="color_accent_amber">#FFFFFF</color>
    <color name="color_accent_amber_light">#000000</color>

    <!-- SOS red. Brighter than the old brick so it still reads as red beside black and white.
         Pressed state stays in the same red. -->
    <color name="color_sos_red">#E10600</color>
    <color name="color_sos_red_dark">#B00000</color>
    <color name="color_sos_red_overlay">#80E10600</color>

    <color name="color_shadow">#00000000</color>
    <color name="color_overlay">#99000000</color>

    <!-- Clock is drawn, not themed by the OEM. Black face, white hands, on the black page. -->
    <color name="color_clock_face">#000000</color>
    <color name="color_clock_border">#FFFFFF</color>
    <color name="color_clock_hand_hour">#FFFFFF</color>
    <color name="color_clock_hand_minute">#FFFFFF</color>
    <color name="color_clock_tick_major">#FFFFFF</color>
    <color name="color_clock_tick_minor">#FFFFFF</color>
    <color name="color_clock_center">#FFFFFF</color>

</resources>
