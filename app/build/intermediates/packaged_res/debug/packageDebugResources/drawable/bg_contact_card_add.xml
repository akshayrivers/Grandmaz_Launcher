<?xml version="1.0" encoding="utf-8"?>
<!-- Background for the empty "Add Contact" slot.
     Slightly darker than white — visually distinct from filled
     contact cards but the same shape and size.
     Dashed border signals "this is a slot to fill". -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/color_bg_secondary" />
    <stroke
        android:width="2dp"
        android:color="@color/color_divider"
        android:dashWidth="8dp"
        android:dashGap="4dp" />
    <corners android:radius="24dp" />
</shape>
