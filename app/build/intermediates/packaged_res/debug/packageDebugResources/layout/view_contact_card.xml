<?xml version="1.0" encoding="utf-8"?>
<!--
    Home screen contact card — full bleed photo with name overlay.

    The photo fills the entire card. A dark gradient at the bottom
    ensures the name is always readable regardless of photo brightness.
    This is faster to recognise than a split photo+label layout because
    the face occupies the full card area — the user sees the person,
    not a form element.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Full-bleed photo — fills entire card, center-cropped -->
    <ImageView
        android:id="@+id/ivContactPhoto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="Contact photo" />

    <!-- Gradient scrim — dark at bottom, transparent at top.
         Ensures name text is always readable regardless of photo colour.
         Height is set to match_parent; the gradient itself fades to
         transparent at the top so it only visually covers the bottom half. -->
    <View
        android:id="@+id/nameScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="bottom"
        android:background="@drawable/gradient_contact_name_scrim" />

    <!-- Name label — sits above the gradient, pinned to bottom -->
    <TextView
        android:id="@+id/tvContactName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:maxLines="1"
        android:ellipsize="end"
        android:shadowColor="#80000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="3" />

</FrameLayout>
